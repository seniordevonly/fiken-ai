{
  "name": "fiken-mcp",
  "version": "0.1.0",
  "description": "MCP server providing tools for Fiken Purchase Service integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "fiken",
    "accounting",
    "purchase",
    "api"
  ],
  "author": "Fiken Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "fiken-shared": "file:../fiken-shared",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "fiken-mcp": "./dist/index.js"
  }
}
