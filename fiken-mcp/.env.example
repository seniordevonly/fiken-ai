# Fiken MCP Server Environment Variables

# Required: Your Fiken API token
FIKEN_API_TOKEN=your-fiken-api-token

# Optional: Default company slug (if not provided, must be specified in each tool call)
FIKEN_COMPANY_SLUG=your-company-slug

# Optional: Custom Fiken API base URL (defaults to https://api.fiken.no/api/v2)
FIKEN_BASE_URL=https://api.fiken.no/api/v2

# Optional: Request timeout in milliseconds (defaults to 30000)
FIKEN_TIMEOUT=30000

# Required in HTTP mode (enabled when PORT is set): every /mcp request must send
# "Authorization: Bearer <MCP_AUTH_TOKEN>". The server refuses to start in HTTP mode without it.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HTTP mode, OAuth (ChatGPT): client credentials accepted by /oauth/token.
# OAuth is disabled unless both are set. Generate the secret with: openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
